# Copy this file to .env and fill in whichever keys you have:
#   cp .env.example .env
#
# Examples that hit a real provider call core::load_dotenv() at the top of
# main(), which loads .env from the current working directory (so run
# example binaries from the repo root). A real exported environment
# variable always takes precedence over this file. .env itself is
# gitignored -- never commit real keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Gemini (GeminiChat)
GOOGLE_API_KEY=

# Azure OpenAI (AzureOpenAIChat) -- AzureOpenAIConfig::deployment has no
# generic env var in the library itself; AZURE_OPENAI_DEPLOYMENT below is
# just what examples/more_providers_demo.cpp happens to read.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI-compatible preset providers (GroqChat / MistralChat / DeepSeekChat)
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
